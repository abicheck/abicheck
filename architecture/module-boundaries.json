{
  "schema_version": 1,
  "purpose": "Repository architecture contract for bounded modules, dependency direction, and legacy-file shrinkage.",
  "line_policies": [
    {
      "name": "production",
      "globs": ["abicheck/**/*.py", "abicheck/*.py"],
      "warning_lines": 500,
      "new_file_max_lines": 800,
      "legacy_no_growth_above_lines": 800
    },
    {
      "name": "scripts",
      "globs": ["scripts/**/*.py", "scripts/*.py"],
      "warning_lines": 600,
      "new_file_max_lines": 1000,
      "legacy_no_growth_above_lines": 1000
    },
    {
      "name": "tests",
      "globs": ["tests/**/*.py", "tests/*.py"],
      "warning_lines": 900,
      "new_file_max_lines": 1200,
      "legacy_no_growth_above_lines": 1200
    }
  ],
  "ignore_globs": [
    "**/__pycache__/**",
    "**/.venv/**",
    "**/generated/**"
  ],
  "forbidden_new_top_level_prefixes": [
    "aggregate_",
    "bundle_",
    "change_registry_",
    "cli_",
    "contract_",
    "diff_",
    "dumper_",
    "finding_",
    "reporter_",
    "service_"
  ],
  "target_layers": {
    "domain": {
      "path": "abicheck/domain",
      "responsibility": "Stable ABI facts, finding identity, result and decision value objects. No I/O and no frontend dependencies.",
      "may_import_layers": []
    },
    "evidence": {
      "path": "abicheck/evidence",
      "responsibility": "Binary, debug, header, build and source fact extraction. Produces facts; never classifies severity or renders output.",
      "may_import_layers": ["domain", "storage"]
    },
    "compare": {
      "path": "abicheck/compare",
      "responsibility": "Old/new matching, diff detectors, comparability and impact analysis. Emits typed findings without applying user policy.",
      "may_import_layers": ["domain"]
    },
    "evaluate": {
      "path": "abicheck/evaluate",
      "responsibility": "Suppression, contract relevance, compatibility classification, severity and gate decisions.",
      "may_import_layers": ["domain", "compare"]
    },
    "storage": {
      "path": "abicheck/storage",
      "responsibility": "Snapshot/report schemas, serialization, caches and persisted envelopes.",
      "may_import_layers": ["domain"]
    },
    "workflows": {
      "path": "abicheck/workflows",
      "responsibility": "Typed orchestration for dump, compare, scan, bundle/release, aggregate, deps and project operations.",
      "may_import_layers": ["domain", "evidence", "compare", "evaluate", "storage"]
    },
    "report": {
      "path": "abicheck/report",
      "responsibility": "Pure projections and format renderers over immutable typed results. No extraction, policy mutation or CLI behavior.",
      "may_import_layers": ["domain", "compare", "evaluate"]
    },
    "interfaces": {
      "path": "abicheck/interfaces",
      "responsibility": "Click CLI, typed Python façade and compatibility adapters. Translate inputs to requests and project results; no domain implementation.",
      "may_import_layers": ["domain", "workflows", "report"]
    }
  },
  "legacy_import_layers": [
    {
      "layer": "interfaces",
      "patterns": ["abicheck.cli", "abicheck.cli_*", "abicheck.compat.cli"]
    },
    {
      "layer": "workflows",
      "patterns": [
        "abicheck.service",
        "abicheck.service_*",
        "abicheck.scan_engine",
        "abicheck.aggregate",
        "abicheck.aggregate_*",
        "abicheck.bundle_analysis"
      ]
    },
    {
      "layer": "evidence",
      "patterns": [
        "abicheck.dumper",
        "abicheck.dumper_*",
        "abicheck.buildsource.inline",
        "abicheck.buildsource.extract*"
      ]
    },
    {
      "layer": "compare",
      "patterns": [
        "abicheck.diff_*",
        "abicheck.comparability",
        "abicheck.reachability*",
        "abicheck.bundle",
        "abicheck.bundle_*",
        "abicheck.buildsource.source_graph*"
      ]
    },
    {
      "layer": "evaluate",
      "patterns": [
        "abicheck.suppression*",
        "abicheck.policy*",
        "abicheck.severity",
        "abicheck.contract_*"
      ]
    },
    {
      "layer": "report",
      "patterns": ["abicheck.reporter", "abicheck.reporter_*"]
    },
    {
      "layer": "storage",
      "patterns": [
        "abicheck.serialization",
        "abicheck.snapshot_io",
        "abicheck.cache*",
        "abicheck.schema*"
      ]
    },
    {
      "layer": "domain",
      "patterns": [
        "abicheck.models",
        "abicheck.change_registry",
        "abicheck.change_registry_*",
        "abicheck.finding_identity"
      ]
    }
  ],
  "legacy_families": {
    "abicheck/cli.py and abicheck/cli_*.py": "abicheck/interfaces/cli plus thin abicheck/cli.py compatibility façade",
    "abicheck/service*.py and abicheck/scan_engine.py": "abicheck/workflows",
    "abicheck/dumper*.py and platform/debug metadata modules": "abicheck/evidence",
    "abicheck/diff_*.py, comparability.py and impact logic": "abicheck/compare",
    "abicheck/suppression*.py, policy*, severity.py and contract_*": "abicheck/evaluate",
    "abicheck/reporter*.py and format modules": "abicheck/report",
    "abicheck/aggregate*.py": "abicheck/workflows/aggregate",
    "abicheck/bundle*.py and release orchestration": "abicheck/compare/bundle plus abicheck/workflows/release",
    "abicheck/serialization.py, snapshot_io.py, schemas and caches": "abicheck/storage"
  },
  "seed_debt_inventory": {
    "abicheck/aggregate.py": {"lines": 2000, "kind": "workflow monolith", "target": "workflows/aggregate"},
    "abicheck/bundle.py": {"lines": 2000, "kind": "analysis plus loading plus compatibility façade", "target": "compare/bundle and workflows/release"},
    "abicheck/buildsource/inline.py": {"lines": 2000, "kind": "configuration plus extraction orchestration", "target": "evidence/build and evaluate/config"},
    "abicheck/buildsource/source_graph.py": {"lines": 2000, "kind": "graph model plus build plus diff compatibility façade", "target": "compare/source_graph"},
    "abicheck/change_registry.py": {"lines": 2000, "kind": "declarative catalog", "target": "domain/change_catalog"},
    "abicheck/dumper_castxml.py": {"lines": 2000, "kind": "backend parser", "target": "evidence/header/castxml"},
    "abicheck/reporter.py": {"lines": 2000, "kind": "report construction plus compatibility façade", "target": "report/model and report/json"},
    "abicheck/reporter_markdown.py": {"lines": 2000, "kind": "format renderer", "target": "report/markdown"},
    "abicheck/cli_compare_helpers.py": {"lines": 1998, "kind": "frontend plus workflow logic", "target": "interfaces/cli/compare and workflows/compare"},
    "abicheck/cli_compare_release.py": {"lines": 1998, "kind": "frontend plus release workflow", "target": "interfaces/cli/release and workflows/release"},
    "abicheck/cli_options.py": {"lines": 1977, "kind": "cross-command option registry", "target": "interfaces/cli/options"},
    "abicheck/cli.py": {"lines": 1959, "kind": "root frontend plus helpers plus compatibility re-exports", "target": "interfaces/cli with a thin compatibility façade"}
  }
}
