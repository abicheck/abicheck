# Where scripts/setup_dev_env.sh creates its isolated dev venv, and how it
# picks the interpreter to create it with -- one source of truth so an
# adapter needing that venv's bin dir on PATH (e.g.
# .claude/hooks/session-start.sh, to persist it for the rest of a session)
# can't drift from it, the same pattern castxml_pin.env already establishes
# for the castxml install path.
#
# AGENTS.md names Python 3.13 as this repo's canonical dev/CI interpreter
# (the one Linux unit-test lane the 95% coverage floor runs on). Prefer it
# by name if present; fall back to whatever `python3` resolves to
# otherwise (still >=3.10, the supported floor) rather than failing outright
# -- a contributor without 3.13 installed should still get a working,
# just non-canonical, environment. dev_venv_python() is a function, not a
# plain variable, because "which interpreter is actually on this PATH
# right now" can only be answered at call time.
dev_venv_python() {
  # Not just `command -v`: a version-manager shim (pyenv, asdf, ...) can
  # be present on PATH for a version that isn't actually installed/active
  # -- `command -v python3.13` succeeds against the shim itself, but
  # running it exits 127 ("version not installed"). Probe real execution
  # before trusting it, since the caller of this function relies on
  # whatever it returns actually running (this script sources under
  # `set -euo pipefail`, so a python3.13 that exists-but-doesn't-run
  # would otherwise abort the whole setup instead of falling back).
  if command -v python3.13 >/dev/null 2>&1 && python3.13 --version >/dev/null 2>&1; then
    echo "python3.13"
  else
    echo "python3"
  fi
}

# Keyed by the resolved interpreter's own X.Y version (not just "python3"),
# so a host that gains or loses python3.13 -- or simply runs a different
# python3 minor version than a previous session did -- lands in a fresh
# venv directory instead of silently reusing one built for a different
# interpreter. `python3 --version` is e.g. "Python 3.13.2"; strip the
# leading "Python " and the patch component.
DEV_VENV_PYTHON_VERSION="$("$(dev_venv_python)" --version 2>&1 | awk '{print $2}' | cut -d. -f1,2)"
DEV_VENV_DIR="${HOME}/.cache/abicheck-dev-venv-py${DEV_VENV_PYTHON_VERSION}"
