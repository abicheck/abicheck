# Where scripts/setup_dev_env.sh creates its isolated dev venv, and where
# any adapter needing that venv's bin dir on PATH (e.g.
# .claude/hooks/session-start.sh, to persist it for the rest of a session)
# should look -- one source of truth so the two can't drift, the same
# pattern castxml_pin.env already establishes for the castxml install path.
DEV_VENV_DIR="${HOME}/.cache/abicheck-dev-venv"
