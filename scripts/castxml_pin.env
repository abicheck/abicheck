# Canonical CastXML conda-forge pin, shared between scripts/setup_dev_env.sh
# and any adapter that needs to know where the pinned castxml ends up (e.g.
# .claude/hooks/session-start.sh, to add it to PATH for the rest of a
# session). One source of truth so the pin can't drift between callers.
#
# CASTXML_BUILD: keep in lockstep with pixi.lock's committed linux-64 solve
# (`grep castxml pixi.lock`) -- bump both together.
CASTXML_BUILD="castxml=0.7.0=hde8d07d_0"

# CASTXML_LOCKED_SPECS: the complete resolved runtime closure for
# CASTXML_BUILD on conda-forge linux-64, pinned exactly (not just the
# direct castxml matchspec) -- castxml's own `depends:` only constrains its
# transitive deps to ranges (e.g. `libllvm20 >=20.1.8,<20.2.0a0`), so an
# unpinned `micromamba create castxml=...` re-solves those from whatever
# conda-forge currently has, and can drift even while CASTXML_BUILD stays
# fixed (observed: this exact set no longer matches pixi.lock's own
# linux-64 solve for a couple of these packages, e.g. libiconv
# 1.18-h3b78370_2 there vs 1.18-h0cb94f2_3 solved fresh here days later).
#
# Deliberately not copied from pixi.lock directly: every pixi environment
# that carries castxml also carries a full compiler toolchain (gcc/clang,
# via the native-toolchain/parity features) bundled into the same
# solve-group, so pixi.lock has no "castxml alone" environment to lift this
# list from. This is this script's own verified-working closure instead --
# bump it (and re-verify a real install) alongside CASTXML_BUILD.
CASTXML_LOCKED_SPECS=(
  "_openmp_mutex=4.5=20_gnu"
  "castxml=0.7.0=hde8d07d_0"
  "icu=78.3=py310h44b86e0_2"
  "libclang-cpp20.1=20.1.8=default_h99862b1_16"
  "libgcc=16.2.0=ha9f2e26_4"
  "libgomp=16.2.0=he0feb66_4"
  "libiconv=1.18=h0cb94f2_3"
  "libllvm20=20.1.8=hf7376ad_1"
  "liblzma=5.8.3=hb03c661_1"
  "libstdcxx=16.2.0=h934c35e_4"
  "libxml2=2.15.3=h49c6c72_1"
  "libxml2-16=2.15.3=hca6bf5a_1"
  "libzlib=1.3.2=h25fd6f3_3"
  "zstd=1.5.7=hb78ec9c_7"
)

# The install prefix is keyed by the exact pinned build string, so bumping
# CASTXML_BUILD always lands in a fresh directory -- a stale prefix from an
# older (or, pre-pin, unconstrained) install can never be silently reused as
# if it were this pin; it's just an orphaned directory. Bump
# CASTXML_PINSET_VERSION too (independent of CASTXML_BUILD) if
# CASTXML_LOCKED_SPECS ever changes without CASTXML_BUILD itself changing
# (e.g. a transitive-dependency-only re-pin), so that alone also invalidates
# the cache the same way.
CASTXML_PINSET_VERSION="1"
CASTXML_PREFIX="${HOME}/.cache/abicheck-castxml-conda/${CASTXML_BUILD}-pinset${CASTXML_PINSET_VERSION}"
