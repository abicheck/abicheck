{
 "select": "pilot",
 "modes": [
  "abicheck",
  "abidiff",
  "abicc-dump",
  "abicc-xml"
 ],
 "configs": [
  "dwarf+headers",
  "stripped+headers"
 ],
 "compiler": "gcc",
 "cases": [
  {
   "op": "struct_append_field",
   "seed": "c_core",
   "cls": "abi_break"
  },
  {
