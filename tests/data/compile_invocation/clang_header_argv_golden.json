{
  "clang-cl-msvc": [
    "clang-cl",
    "-I",
    "C:/inc",
    "-x",
    "c",
    "-std=gnu11",
    "-D__malloc__(...)=__malloc__",
    "-fsyntax-only",
    "-ferror-limit=0",
    "-Xclang",
    "-ast-dump=json",
    "<abicheck-aggregate>.h"
  ],
  "cxx-explicit-std": [
    "clang++",
    "-std=c++17",
    "-D__malloc__(...)=__malloc__",
    "-fsyntax-only",
    "-ferror-limit=0",
    "-Xclang",
    "-ast-dump=json",
    "<abicheck-aggregate>.h"
  ],
