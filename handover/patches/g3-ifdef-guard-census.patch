diff --git a/abicheck/extract/headers/preprocessor_branches.py b/abicheck/extract/headers/preprocessor_branches.py
new file mode 100644
index 000000000..ac74922be
--- /dev/null
+++ b/abicheck/extract/headers/preprocessor_branches.py
@@ -0,0 +1,301 @@
+# Copyright 2026 Nikolay Petrov
+# SPDX-License-Identifier: Apache-2.0
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Function declarations a header parse could not see: they sit in a
+preprocessor branch the parse's configuration excluded.
+
+A header-AST parse sees one preprocessor configuration. A declaration under
+``#ifdef FOO`` is removed before the parser runs when ``FOO`` is not defined,
+and the export it declares then reads as "undeclared" with no stated reason
+(field report H5, generalized beyond ``sycl::``).
+
+**Which branches were excluded is decided by the compiler, not by this
+module.** The castxml backend already re-runs its exact command with
+``-E -dD`` (:mod:`.castxml.preprocessed_text`): every source line that
+survived preprocessing appears in that output under a line marker naming its
+``file:line``. This module only scans each public header's *raw* text for its
+``#if``/``#ifdef``/``#ifndef``/``#elif``/``#else``/``#endif`` structure and
+asks, per branch, whether any of its lines survived. Evaluating the
+conditions here instead would mean re-implementing the preprocessor
+(``__has_include``, function-like macros, macros a header defines for a
+later one, the compiler's predefined set) and getting some of it wrong; the
+compiler's own answer has none of those failure modes.
+
+A branch is **excluded** when it has at least one line that would produce
+output if taken (code, or a ``#define``/``#undef``, which ``-dD`` keeps in
+place) and none of them did. Its *guard macros* are the identifiers of every
+condition of its ``#if`` group up to and including its own (an ``#else`` of
+``#ifdef FOO`` is guarded by ``FOO`` too). A classic include guard
+(``#ifndef X`` immediately followed by ``#define X``) is never reported and
+``X`` never names a guard.
+
+A hidden declaration is attributed to the excluded branches enclosing it,
+innermost first, up to the first enclosing branch that produced output.
+Branches with code of their own outrank a branch whose only content is the
+nested group (whose exclusion cannot be told apart from the nested one's);
+see ``docs/contribute/known-gaps.md`` for that ambiguity.
+
+Declared names are found by a lightweight token scan (an identifier followed
+by ``(`` on a code line), which is evidence for attribution, never a
+declaration of record.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass, field
+
+_COMMENT = re.compile(r"//[^\n]*|/\*.*?\*/", re.DOTALL)
+_DIRECTIVE = re.compile(r"^\s*#\s*(\w+)\s*(.*)$")
+_IDENT = re.compile(r"[A-Za-z_]\w*")
+_CALL = re.compile(r"\b([A-Za-z_]\w*)\s*\(")
+#: Directives whose own line ``-E -dD`` keeps in place.
+_EMITTED_DIRECTIVES = frozenset({"define", "undef"})
+#: Identifiers in a condition that are operators or builtins, not macros.
+_CONDITION_NOISE = frozenset(
+    {
+        "defined",
+        "__has_include",
+        "__has_include_next",
+        "__has_attribute",
+        "__has_cpp_attribute",
+        "__has_builtin",
+        "__has_feature",
+        "__has_extension",
+        "true",
+        "false",
+    }
+)
+#: Identifiers followed by ``(`` that never name a declared function.
+_NOT_A_DECLARATION = frozenset(
+    {
+        "if",
+        "while",
+        "for",
+        "switch",
+        "return",
+        "sizeof",
+        "alignof",
+        "alignas",
+        "decltype",
+        "noexcept",
+        "static_assert",
+        "_Static_assert",
+        "__attribute__",
+        "__declspec",
+        "__typeof__",
+        "typeof",
+        "operator",
+        "throw",
+        "catch",
+        "defined",
+        "requires",
+        "explicit",
+    }
+)
+
+
+@dataclass
+class Branch:
+    """One arm of an ``#if`` group (lines are 1-based, *body* exclusive of
+    the directive lines that delimit it)."""
+
+    guard_macros: tuple[str, ...]
+    parent: int | None
+    include_guard: bool = False
+    #: Lines that produce output when taken, directly in this branch.
+    own_lines: list[int] = field(default_factory=list)
+    #: The same, including every nested branch's lines.
+    all_lines: list[int] = field(default_factory=list)
+    #: ``(name, line)`` of each call-shaped identifier directly in this branch.
+    names: list[tuple[str, int]] = field(default_factory=list)
+
+
+def _strip_comments(text: str) -> str:
+    """Blank comments, keeping every newline so line numbers hold."""
+    return _COMMENT.sub(lambda m: "\n" * m.group(0).count("\n") + " ", text)
+
+
+def _logical_lines(text: str) -> list[tuple[int, str]]:
+    """``(first physical line, joined text)`` with ``\\``-continuations folded."""
+    out: list[tuple[int, str]] = []
+    pending: list[str] = []
+    start = 0
+    for number, raw in enumerate(text.splitlines(), start=1):
+        if not pending:
+            start = number
+        if raw.endswith("\\"):
+            pending.append(raw[:-1])
+            continue
+        pending.append(raw)
+        out.append((start, " ".join(pending)))
+        pending = []
+    if pending:
+        out.append((start, " ".join(pending)))
+    return out
+
+
+def _condition_macros(expr: str) -> list[str]:
+    expr = re.sub(r"\b\d\w*", " ", expr)  # integer literals and their suffixes
+    return [m for m in _IDENT.findall(expr) if m not in _CONDITION_NOISE]
