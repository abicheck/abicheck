+                kind == "define"
+                and guard_candidate is not None
+                and guard_candidate[1] == name
+                and guard_candidate[0] == current()
+                and not branches[guard_candidate[0]].all_lines
+            ):
+                branches[guard_candidate[0]].include_guard = True
+            record(line_no)
+        guard_candidate = None
+    guards = {b.guard_macros[0] for b in branches if b.include_guard}
+    for b in branches:
+        if guards & set(b.guard_macros) and not b.include_guard:
+            b.guard_macros = tuple(m for m in b.guard_macros if m not in guards)
+    return branches
+
+
+def _excluded(branch: Branch, present: set[int]) -> bool:
+    return (
+        not branch.include_guard
+        and bool(branch.all_lines)
+        and present.isdisjoint(branch.all_lines)
+    )
+
+
+def hidden_declarations(
+    text: str, present: Iterable[int]
+) -> dict[str, set[str]]:
+    """``{guard macro: declared names}`` for one header.
+
+    *present* is the set of the header's line numbers that produced output
+    in the parse's own preprocessing run.
+    """
+    present_set = set(present)
+    branches = scan_branches(text)
+    out: dict[str, set[str]] = {}
+    for b in branches:
+        if not _excluded(b, present_set) or not b.names:
+            continue
+        chain: list[Branch] = []
+        node: Branch | None = b
+        while node is not None and _excluded(node, present_set):
+            chain.append(node)
+            node = branches[node.parent] if node.parent is not None else None
+        with_code = [c for c in chain if c.own_lines]
+        macros = {m for c in (with_code or chain) for m in c.guard_macros}
+        for macro in macros:
+            out.setdefault(macro, set()).update(n for n, _ in b.names)
+    return out
+
+
+def hidden_declarations_for_headers(
+    headers: Iterable[str | os.PathLike[str]],
+    present_lines: Mapping[str, Iterable[int]],
+) -> dict[str, tuple[str, ...]] | None:
+    """Merge :func:`hidden_declarations` over the public *headers*.
+
+    *present_lines* maps a resolved, normalized path to its surviving line
+    numbers. ``None`` when a header cannot be read -- never "nothing hidden".
+    """
+    merged: dict[str, set[str]] = {}
+    for header in headers:
+        key = os.path.normpath(os.path.realpath(header))
+        try:
+            with open(header, encoding="utf-8", errors="replace") as fh:
+                text = fh.read()
+        except OSError:
+            return None
+        for macro, names in hidden_declarations(
+            text, present_lines.get(key, ())
+        ).items():
+            merged.setdefault(macro, set()).update(names)
+    return {m: tuple(sorted(n)) for m, n in sorted(merged.items())}
+
+
+__all__ = [
+    "Branch",
+    "hidden_declarations",
+    "hidden_declarations_for_headers",
+    "scan_branches",
+]
