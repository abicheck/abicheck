+        idx = current()
+        if idx is None:
+            return
+        branches[idx].own_lines.append(line_no)
+        branches[idx].names.extend((n, line_no) for n in names)
+        while idx is not None:
+            branches[idx].all_lines.append(line_no)
+            idx = branches[idx].parent
