diff --git a/tests/test_preprocessor_branches.py b/tests/test_preprocessor_branches.py
new file mode 100644
index 000000000..7a54c26df
--- /dev/null
+++ b/tests/test_preprocessor_branches.py
@@ -0,0 +1,168 @@
+"""Unit tests for the preprocessor-excluded declaration scan.
+
+The scanner never evaluates a condition: which lines survived is the
+compiler's answer. Here that answer is either written out by hand (the
+oracle is the test author's reading of the preprocessor rules) or, in the
+``integration`` cross-check, produced by a real ``g++ -E``.
+"""
+
+from __future__ import annotations
+
+import itertools
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from abicheck.extract.headers.castxml.hidden_declarations import (
+    attach_hidden_declarations,
+    read_hidden_declarations,
+)
+from abicheck.extract.headers.castxml.preprocessed_text import parse_preprocessed
+from abicheck.extract.headers.preprocessor_branches import (
+    hidden_declarations,
+    hidden_declarations_for_headers,
+    scan_branches,
+)
+
+_HEADER = """\
+#ifndef API_H
+#define API_H
+int visible(int);
+#ifdef FOO
+int foo_a(int);
+#  if defined(BAR) && defined(BAZ)
+int nested(void);
+#  endif
+#elif OTHER > 2
+int other(void);
+#else
+int fallback(void);
+#endif
+#ifndef NOPE
+int not_nope(void);
+#endif
+#endif
+"""
+
+
+def _code_lines(text: str) -> dict[str, int]:
+    """Name declared on each line (the test's own index, not the scanner's)."""
+    out = {}
+    for no, line in enumerate(text.splitlines(), start=1):
+        if line.startswith("int "):
+            out[line.split()[1].split("(")[0]] = no
+    return out
+
+
+def _present(text: str, kept: set[str]) -> set[int]:
+    lines = _code_lines(text)
+    # The include guard's `#define` and every kept declaration produce output.
+    return {2} | {lines[n] for n in kept}
+
+
+@pytest.mark.parametrize(
+    ("kept", "expected"),
+    [
+        # Nothing defined: FOO's arm and its nested group are out, #else is in.
+        (
+            {"visible", "fallback", "not_nope"},
+            {"FOO": {"foo_a"}, "OTHER": {"other"}},
+        ),
+        # FOO defined, BAR/BAZ not: only the nested group is out; the #elif
+        # and #else arms of FOO are out too and keep FOO among their guards.
+        (
+            {"visible", "foo_a", "not_nope"},
+            {
+                "BAR": {"nested"},
+                "BAZ": {"nested"},
+                "FOO": {"other", "fallback"},
+                "OTHER": {"other", "fallback"},
+            },
+        ),
+        # NOPE defined: the #ifndef arm is out and names NOPE.
+        (
+            {"visible", "fallback"},
+            {"FOO": {"foo_a"}, "OTHER": {"other"}, "NOPE": {"not_nope"}},
+        ),
+    ],
+)
+def test_hidden_declarations_by_guard(kept: set[str], expected: dict) -> None:
+    got = hidden_declarations(_HEADER, _present(_HEADER, kept))
+    assert got == expected
+
+
+def test_include_guard_is_never_a_guard() -> None:
+    branches = scan_branches(_HEADER)
+    assert [b.include_guard for b in branches].count(True) == 1
+    assert all("API_H" not in b.guard_macros for b in branches)
+    # Even with nothing present the include guard is never reported.
+    assert "API_H" not in hidden_declarations(_HEADER, set())
+
+
+def test_wrapper_without_own_code_defers_to_inner_branch() -> None:
+    text = "#ifdef OUTER\n#ifdef INNER\nint f(void);\n#endif\n#endif\n"
+    assert hidden_declarations(text, set()) == {"INNER": {"f"}}
+
+
+def test_comments_continuations_and_noise_are_ignored() -> None:
+    text = (
+        "/* #ifdef FAKE\n int fake(void);\n#endif */\n"
+        "#if defined(A) || \\\n    __has_include(<x.h>) || 2 > 1L\n"
+        "int g(void); // if (x)\n"
+        "#endif\n"
+    )
+    assert hidden_declarations(text, set()) == {"A": {"g"}}
+
+
+def test_headers_merge_and_unreadable_header(tmp_path: Path) -> None:
+    a = tmp_path / "a.h"
+    a.write_text("#ifdef X\nint a(void);\n#endif\n", encoding="utf-8")
+    b = tmp_path / "b.h"
+    b.write_text("#ifdef X\nint b(void);\n#endif\n", encoding="utf-8")
+    assert hidden_declarations_for_headers([a, b], {}) == {"X": ("a", "b")}
+    key = os.path.normpath(os.path.realpath(a))
+    assert hidden_declarations_for_headers([a], {key: {2}}) == {}
+    assert hidden_declarations_for_headers([tmp_path / "missing.h"], {}) is None
+
+
+def test_xml_round_trip() -> None:
+    from xml.etree.ElementTree import Element
+
+    root = Element("CastXML")
+    assert read_hidden_declarations(root) is None
+    attach_hidden_declarations(root, {"FOO": ("a", "b"), "BAR": ()})
+    assert read_hidden_declarations(root) == {"FOO": ("a", "b")}
+
+
+@pytest.mark.integration
+@pytest.mark.skipif(not shutil.which("g++"), reason="needs g++")
+@pytest.mark.parametrize(
+    "defines",
+    [
+        list(c)
+        for n in range(4)
+        for c in itertools.combinations(["FOO", "BAR", "BAZ", "NOPE"], n)
+    ],
+)
+def test_against_real_preprocessor(tmp_path: Path, defines: list[str]) -> None:
+    """Cross-check against ``g++ -E -dD``: a declaration is reported iff the
+    compiler dropped it, and only under a macro its group's conditions name."""
+    header = tmp_path / "api.h"
+    header.write_text(_HEADER, encoding="utf-8")
+    out = subprocess.run(
+        ["g++", "-E", "-dD", "-x", "c++", *(f"-D{d}" for d in defines), str(header)],
+        capture_output=True,
+        text=True,
+        check=True,
+    ).stdout
+    files, _ = parse_preprocessed(out)
+    key = os.path.normpath(str(header))
+    present = set(files.get(key, {}))
+    got = hidden_declarations(_HEADER, present)
+    reported = set().union(*got.values()) if got else set()
+    dropped = {n for n, line in _code_lines(_HEADER).items() if line not in present}
+    assert reported == dropped
+    assert set(got) <= {"FOO", "BAR", "BAZ", "OTHER", "NOPE"}
