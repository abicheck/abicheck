+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Projecting a richer snapshot to ``binary`` equals dumping at ``binary``.
+
+Bug class ``evidence.depth_projection_diverges_from_shallow_dump``: a
+header-built snapshot projected to ``--depth binary`` had its record/enum
+declarations cleared, so a layout change reached only the raw debug-layout
+fallback (``struct_size_changed``, ``struct_field_removed``) while a
+binary-only dump of the very same library carries its debug-info records in
+``declarations.types`` and is judged by the type detectors
+(``type_size_changed``, ``type_field_added_compatible``,
+``type_field_removed``). Same library, same requested depth, different
+findings.
+
+The invariant, over every catalog case gcc can build: the findings
+(kind, symbol) of ``compare(project(headers dump, binary))`` equal those of
+``compare(binary-only dump)``. The oracle is an independent extraction (a
+dump with no headers), never the projection's own bookkeeping. Any residual
+difference must be named in :data:`RESIDUAL` with the reason the projection
+cannot (or deliberately does not) reproduce it.
+"""
+
+from __future__ import annotations
+
+import shutil
+from pathlib import Path
+
+import pytest
+
+from abicheck.checker import compare
+from abicheck.policy.depth_projection import project_pair_to_depth
+from tests.test_example_autodiscovery import (
+    _ALL_CASES,
+    BUILD_INFO_CASES,
+    CURRENT_PLATFORM,
+    PLATFORMS,
+    REQUIRES_FEATURE,
+    SOURCE_SMOKE_CASES,
+    _build_libs_for_case,
+    _find_sources,
+    _header_list,
+)
+
+#: ``(kind, symbol)`` of one finding.
+Finding = tuple[str, str]
+
+#: ``{case: reason}`` for a case whose projected and binary-only findings
+#: still differ, each for a reason the projection cannot remove.
+RESIDUAL: dict[str, str] = {}
+
+
+def _findings(changes: list) -> set[Finding]:
+    return {(c.kind.value, c.symbol) for c in changes}
+
+
+@pytest.mark.integration
+@pytest.mark.parametrize("case_name", [c for c, _ in _ALL_CASES])
+def test_binary_projection_matches_binary_only_dump(
+    case_name: str, tmp_path: Path, shared_cmake_build_dir: Path | None
+) -> None:
+    if CURRENT_PLATFORM not in PLATFORMS.get(case_name, [CURRENT_PLATFORM]):
+        pytest.skip(f"{case_name}: not on {CURRENT_PLATFORM}")
+    if case_name in BUILD_INFO_CASES or case_name in SOURCE_SMOKE_CASES:
+        pytest.skip(f"{case_name}: needs the CLI build/source path")
+    if not shutil.which("castxml"):
+        pytest.skip("castxml not found in PATH")
+    feature = REQUIRES_FEATURE.get(case_name)
+    if feature is not None:
+        from tests.feature_probe import compiler_supports
+
+        if not compiler_supports(feature):
+            pytest.skip(f"{case_name}: compiler lacks {feature!r}")
+
+    import example_catalog  # on sys.path via test_example_autodiscovery
+
+    from abicheck.dumper import dump
+
+    case_dir = example_catalog.case_dir(case_name)
+    v1_src, v2_src, v1_hdr, v2_hdr = _find_sources(case_dir)
+    v1_lib, v2_lib = _build_libs_for_case(
+        case_name, case_dir, tmp_path, shared_cmake_build_dir, v1_src, v2_src
+    )
+    rich_old = dump(v1_lib, headers=_header_list(v1_hdr), version="v1")
+    rich_new = dump(v2_lib, headers=_header_list(v2_hdr), version="v2")
+    p_old, p_new = project_pair_to_depth(rich_old, rich_new, "binary")
+    projected = _findings(compare(p_old, p_new).changes)
+
+    oracle = _findings(
+        compare(
+            dump(v1_lib, headers=[], version="v1"),
+            dump(v2_lib, headers=[], version="v2"),
+        ).changes
+    )
+    if case_name in RESIDUAL:
+        assert projected != oracle, f"{case_name}: residual gone; drop it"
+        return
+    assert projected == oracle, {
+        "only_projected": sorted(projected - oracle),
+        "only_binary_dump": sorted(oracle - projected),
+    }
