---------------------------- MODULE DispositionTrace ----------------------------
(* E11: trace validation of DispositionPipeline.tla against the real pipeline.

   TraceData.tla (generated by check_trace.py from a run recorded by
   disposition_trace.py) holds one abicheck disposition-pipeline run as a
   sequence of abstract states, one per step boundary. This spec accepts the
   trace only if every consecutive pair is a StepWith of the pipeline spec,
   with the witnesses D, M, A, B, R, C read off the two states, and every
   state satisfies NothingVanishes. TLC reaches the last state with no
   deadlock and no violated invariant exactly when the trace is accepted. *)
EXTENDS Naturals, Sequences, FiniteSets, TraceData

VARIABLES changes, buckets, ledger, seen, fresh, steps, i

P == INSTANCE DispositionPipeline WITH Ids <- TraceIds, MaxSteps <- TraceSteps,
                                       AddsAllowed <- TRUE

pvars == <<changes, buckets, ledger, seen, fresh, steps>>

At(k) == /\ changes = Trace[k].changes /\ buckets = Trace[k].buckets
         /\ ledger = Trace[k].ledger /\ seen = Trace[k].seen
         /\ fresh = Trace[k].fresh

Init == i = 1 /\ steps = 0 /\ At(1)

TraceStep ==
  /\ i < Len(Trace)
  /\ LET n     == Trace[i + 1]
         left  == changes \ n.changes
         M     == left \cap n.buckets
         D     == left \ n.buckets
         A     == n.changes \ changes
         B     == (n.buckets \ buckets) \ changes
         C     == (n.ledger \ ledger) \ (seen \cup A \cup B)
         after == (changes \ (D \cup M)) \cup A
         trig  == Cardinality(after) + Cardinality(M \cup B) < Cardinality(changes)
         R     == ((n.ledger \ ledger) \ C) \ (IF trig THEN D ELSE {})
     IN /\ P!StepWith(D, M, A, B, R, C)
        (* the spec's successor must be the recorded one; At(i + 1)' would
           also prime i and read Trace[i + 2] *)
        /\ changes' = n.changes /\ buckets' = n.buckets
        /\ ledger' = n.ledger /\ seen' = n.seen /\ fresh' = n.fresh
  /\ steps' = steps + 1
  /\ i' = i + 1

Done == i = Len(Trace) /\ UNCHANGED <<pvars, i>>

Next == TraceStep \/ Done

NothingVanishes == P!NothingVanishes
=============================================================================
